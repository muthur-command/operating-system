# Buildroot defconfig for Neardi RK3576 LB200 Board
# Based on odroid_m1_defconfig, adapted for RK3576

BR2_aarch64=y
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_12=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_DL_DIR="$(TOPDIR)/dl"
BR2_CCACHE=y
BR2_CCACHE_DIR="$(HOME)/.buildroot-ccache"
BR2_ENABLE_LTO=y
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_MCOS_PATH)/patches $(BR2_EXTERNAL_MCOS_PATH)/board/neardi/lb200/patches"
BR2_SSP_REGULAR=y
BR2_TARGET_GENERIC_HOSTNAME="mcos"
BR2_TARGET_GENERIC_ISSUE="Welcome to Muthur Command OS"
BR2_INIT_SYSTEMD=y
# BR2_TARGET_GENERIC_REMOUNT_ROOTFS_RW is not set
BR2_TARGET_LOCALTIME="Etc/UTC"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_MCOS_PATH)/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_MCOS_PATH)/scripts/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_MCOS_PATH)/scripts/post-image.sh"
BR2_ROOTFS_POST_SCRIPT_ARGS="$(BR2_EXTERNAL_MCOS_PATH)/board/neardi/lb200 $(BR2_EXTERNAL_MCOS_PATH)/board/neardi/lb200/mcos-hook.sh"

# Linux Kernel
BR2_LINUX_KERNEL=y
# YT8521 PHY: board DTS uses MDIO reg = <0x0> (rk3576-neardi-lb200-gmac.dtsi).
# Upstream motorcomm.c in 6.18.x does not need a driver patch.
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.18.29"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_MCOS_PATH)/kernel/v6.18.y/kernel-arm64-rockchip.config"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_MCOS_PATH)/kernel/v6.18.y/mcos.config $(BR2_EXTERNAL_MCOS_PATH)/kernel/v6.18.y/docker.config $(BR2_EXTERNAL_MCOS_PATH)/kernel/v6.18.y/device-support.config $(BR2_EXTERNAL_MCOS_PATH)/kernel/v6.18.y/device-support-wireless.config $(BR2_EXTERNAL_MCOS_PATH)/board/neardi/lb200/kernel.config"
BR2_LINUX_KERNEL_LZ4=y
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="rockchip/rk3576-mc-neardi-lb200"
BR2_LINUX_KERNEL_DTB_OVERLAY_SUPPORT=y
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_LINUX_KERNEL_NEEDS_HOST_LIBELF=y

# BusyBox
BR2_PACKAGE_BUSYBOX_CONFIG="$(BR2_EXTERNAL_MCOS_PATH)/busybox.config"
BR2_PACKAGE_BUSYBOX_INDIVIDUAL_BINARIES=y

# Storage and filesystem tools
BR2_PACKAGE_V4L2LOOPBACK=y
BR2_PACKAGE_PIGZ=y
BR2_PACKAGE_JQ=y
BR2_PACKAGE_CIFS_UTILS=y
BR2_PACKAGE_DOSFSTOOLS=y
BR2_PACKAGE_DOSFSTOOLS_FSCK_FAT=y
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_E2FSPROGS_E2IMAGE=y
BR2_PACKAGE_E2FSPROGS_RESIZE2FS=y
BR2_PACKAGE_NFS_UTILS=y

# Linux Firmware (standard WiFi/BT firmware)
BR2_PACKAGE_LINUX_FIRMWARE=y
BR2_PACKAGE_LINUX_FIRMWARE_MEDIATEK_MT7921_BT=y
