config BR2_PACKAGE_ROCKCHIP_MALI_SDK
	bool "rockchip-mali-sdk"
	depends on BR2_aarch64
	select BR2_PACKAGE_HAS_LIBEGL
	select BR2_PACKAGE_HAS_LIBGLES
	select BR2_PACKAGE_HAS_LIBGBM
	select BR2_PACKAGE_HAS_LIBOPENCL
	select BR2_PACKAGE_LIBDRM
	help
	  Rockchip Mali GPU driver library (SDK version).
	  This package provides the Mali GPU driver for Rockchip SoCs,
	  supporting OpenGL ES, OpenCL, and Vulkan.
	  This is the SDK-specific version for RK3576 Mali G52.

	  https://github.com/rockchip-linux/libmali

if BR2_PACKAGE_ROCKCHIP_MALI_SDK

config BR2_PACKAGE_PROVIDES_LIBEGL
	string
	default "rockchip-mali-sdk"

config BR2_PACKAGE_PROVIDES_LIBGLES
	string
	default "rockchip-mali-sdk"

config BR2_PACKAGE_PROVIDES_LIBGBM
	string
	default "rockchip-mali-sdk"

config BR2_PACKAGE_PROVIDES_LIBOPENCL
	string
	default "rockchip-mali-sdk"

config BR2_PACKAGE_ROCKCHIP_MALI_SDK_HAS_EGL
	bool "EGL support"
	default y

config BR2_PACKAGE_ROCKCHIP_MALI_SDK_HAS_GLES
	bool "OpenGL ES support"
	default y

config BR2_PACKAGE_ROCKCHIP_MALI_SDK_HAS_OPENCL
	bool "OpenCL support"
	default y

config BR2_PACKAGE_ROCKCHIP_MALI_SDK_HAS_VULKAN
	bool "Vulkan support"

config BR2_PACKAGE_ROCKCHIP_MALI_SDK_HAS_GBM
	bool "GBM support"
	default y

config BR2_PACKAGE_ROCKCHIP_MALI_SDK_HAS_X11
	bool "X11 support"

config BR2_PACKAGE_ROCKCHIP_MALI_SDK_HAS_WAYLAND
	bool "Wayland support"

config BR2_PACKAGE_ROCKCHIP_MALI_SDK_HAS_DUMMY
	bool "Dummy platform support"

config BR2_PACKAGE_ROCKCHIP_MALI_SDK_CUSTOM_PLATFORM
	string "Custom platform string"
	default ""

endif

comment "rockchip-mali-sdk needs an aarch64 toolchain"
	depends on !BR2_aarch64
