+{
+	unsigned long val;
+
+	if (!n)
+		return -EINVAL;
+	if (kstrtoul(buf, 10, &val))
+		return -EINVAL;
+	if (val > 1)
+		return -EINVAL;
+
+	if (val)
+		rockchip_request_early_suspend();
+	else
+		rockchip_request_late_resume();
+
+	return n;
+}
+
