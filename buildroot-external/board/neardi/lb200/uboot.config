# U-Boot overlay configuration for Neardi LB200 (mainline U-Boot)
# Boot flow: read the raw boot_a/boot_b FIT partition into RAM, then `bootm`.
#
# Vendor rkbin SPL (U-Boot 2017.09) loads an unsigned FIT from uboot; drop
# mainline FIT signatures so u-boot.itb matches SDK fit_gen_uboot_img output.
# CONFIG_FIT_SIGNATURE is not set
# CONFIG_SPL_FIT_SIGNATURE is not set

CONFIG_SKIP_LOWLEVEL_INIT=y
CONFIG_SYS_LOAD_ADDR=0x40c00800
# Vendor SPL/ATF debug port is UART0 — do not re-init (can hang in TEMT wait).
CONFIG_DEBUG_UART_BASE=0x2AD40000
CONFIG_SPL_DEBUG_UART_BASE=0x2AD40000
CONFIG_DEBUG_UART_SKIP_INIT=y
CONFIG_DEBUG_UART_ANNOUNCE=y
CONFIG_EXPERT=y
# SMPEN msr can fault on RK3576 Cortex-A72 at EL1 after ATF exit
# CONFIG_ARMV8_SET_SMPEN is not set
# CONFIG_BOARD_LATE_INIT is not set
# CONFIG_BOOTSTD_FULL is not set
# CONFIG_MISC_INIT_R is not set
# SPL/ATF already powers the board; skip RK806 PMIC/regulator children.
# i2c1 is also disabled in the U-Boot DT overlay.
# CONFIG_PMIC_CHILDREN is not set
# CONFIG_DM_PMIC is not set
# CONFIG_REGULATOR_RK8XX is not set
# CONFIG_CMD_REGULATOR is not set
# Boot path does not need I2C or DesignWare MMC (eMMC uses SDHCI only).
# CONFIG_I2C is not set
# CONFIG_DM_I2C is not set
# CONFIG_CMD_I2C is not set
# CONFIG_SYS_I2C_ROCKCHIP is not set
# CONFIG_MMC_DW is not set
# CONFIG_MMC_DW_ROCKCHIP is not set
# DM_REGULATOR must stay enabled: ROCKCHIP_RK3576 selects DM_REGULATOR_FIXED.
CONFIG_DM_REGULATOR=y
# Boot path does not need OTP/ADC/RNG; avoid dm_autoprobe stalls after PMIC.
# CONFIG_ROCKCHIP_OTP is not set
# CONFIG_ADC is not set
# CONFIG_SARADC_ROCKCHIP is not set
# CONFIG_RNG_ROCKCHIP is not set
# CONFIG_DISPLAY_CPUINFO is not set
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_SDMA=y
CONFIG_MMC_SDHCI_ROCKCHIP=y

# SDK strips unused DT props from the U-Boot DTB (see OF_U_BOOT_REMOVE_PROPS).
CONFIG_OF_DTB_PROPS_REMOVE=y
CONFIG_OF_REMOVE_PROPS="pinctrl-0 pinctrl-names clock-names interrupt-parent assigned-clocks assigned-clock-rates assigned-clock-parents"

# Boot-only: no Ethernet/USB/display drivers needed before bootm.
# CONFIG_DWC_ETH_QOS is not set
# CONFIG_PHY_MOTORCOMM is not set

# Commands needed by the bootcmd below
CONFIG_CMD_MMC=y
CONFIG_CMD_PART=y
CONFIG_CMD_BOOTI=y
CONFIG_CMD_FDT=y
CONFIG_CMD_SETEXPR=y
CONFIG_HUSH_PARSER=y

# Read the FIT from the A/B boot partition (by GPT PARTLABEL) and boot it.
# kernel_comp_addr_r (0x4a000000) is used as the FIT scratch buffer: the kernel
# is uncompressed so that region is otherwise free, and it does not overlap
# kernel_addr_r (0x42000000) or fdt_addr_r (0x52000000).
#
# Slot selection reads Rockchip/AVB AvbABData @ misc+0x800 (same layout as SPL
# and updateEngine).  The active slot gets androidboot.slot_suffix and a matching
# root=PARTLABEL=system_{a,b} so userspace boot control can mark the slot good.
CONFIG_USE_BOOTCOMMAND=y
CONFIG_BOOTCOMMAND="setenv fdt_high 0x48000000; setenv ab_addr 0x48080000; setenv bootargs_base \"earlycon=uart8250,mmio32,0x2ad40000 console=ttyS0,1500000n8 rw rootwait zram.num_devices=3 fsck.repair=yes systemd.unit=multi-user.target\"; mmc dev 0; part start mmc 0 misc miscstart; setexpr abblk ${miscstart} + 4; mmc read ${ab_addr} ${abblk} 1; setexpr.b slot0pri *0x48080008; setexpr.b slot1pri *0x4808000c; if test ${slot1pri} -gt ${slot0pri}; then setenv boot_slot b; else setenv boot_slot a; fi; if test ${boot_slot} = b; then setenv bootargs \"${bootargs_base} androidboot.slot_suffix=_b root=PARTLABEL=system_b\"; if part start mmc 0 boot_b bootstart && part size mmc 0 boot_b bootsize; then mmc read ${kernel_comp_addr_r} ${bootstart} ${bootsize}; bootm ${kernel_comp_addr_r}; fi; else setenv bootargs \"${bootargs_base} androidboot.slot_suffix=_a root=PARTLABEL=system_a\"; if part start mmc 0 boot_a bootstart && part size mmc 0 boot_a bootsize; then mmc read ${kernel_comp_addr_r} ${bootstart} ${bootsize}; bootm ${kernel_comp_addr_r}; fi; fi"
