#!/bin/sh
# MCOS LB200: dhclient hook using iproute2 (no net-tools ifconfig/route).

mask2cidr() {
	local mask=$1 sum=0 o

	[ -n "$mask" ] || return 1
	for o in $(echo "$mask" | tr '.' ' '); do
		case $o in
		255) sum=$((sum + 8));;
		254) sum=$((sum + 7));;
		252) sum=$((sum + 6));;
		248) sum=$((sum + 5));;
		240) sum=$((sum + 4));;
		224) sum=$((sum + 3));;
		192) sum=$((sum + 2));;
		128) sum=$((sum + 1));;
		0) ;;
		*) return 1;;
		esac
	done
	[ "$sum" -gt 0 ] || return 1
	echo "$sum"
}

iface_cidr() {
	local cidr

	cidr=$(mask2cidr "${new_subnet_mask:-}") || cidr=24
	[ "$cidr" -ge 1 ] 2>/dev/null || cidr=24
	[ "$cidr" -le 32 ] 2>/dev/null || cidr=24
	echo "$cidr"
}

iface_network() {
	local cidr=$1

	if [ -n "${new_network_number:-}" ]; then
		echo "${new_network_number}"
		return
	fi
	echo "$new_ip_address" | awk -F. -v cidr="$cidr" '{
		if (cidr >= 24) printf "%d.%d.%d.0", $1, $2, $3;
		else if (cidr >= 16) printf "%d.%d.0.0", $1, $2;
		else if (cidr >= 8) printf "%d.0.0.0", $1;
		else print "0.0.0.0";
	}'
}

ensure_link_route() {
	local cidr=$1 network

	network=$(iface_network "$cidr")
	ip -4 route replace "${network}/${cidr}" dev "$interface" \
		proto kernel scope link src "${new_ip_address}"
}

make_resolv_conf() {
	if [ -L /etc/resolv.conf ] || [ ! -f /etc/resolv.conf ]; then
		rm -f /etc/resolv.conf
	fi
	: > /etc/resolv.conf.dhclient
	chmod 644 /etc/resolv.conf.dhclient
	if [ -n "${new_domain_search:-}" ]; then
		echo "search ${new_domain_search}" >> /etc/resolv.conf.dhclient
	elif [ -n "${new_domain_name:-}" ]; then
		echo "search ${new_domain_name}" >> /etc/resolv.conf.dhclient
	fi
	if [ -n "${new_domain_name_servers:-}" ]; then
		for nameserver in $new_domain_name_servers; do
			echo "nameserver ${nameserver}" >> /etc/resolv.conf.dhclient
		done
	elif [ -n "${new_routers:-}" ]; then
		for router in $new_routers; do
			echo "nameserver ${router}" >> /etc/resolv.conf.dhclient
		done
	fi
	if [ -s /etc/resolv.conf.dhclient ]; then
		cat /etc/resolv.conf.dhclient > /etc/resolv.conf
	fi
}

set_default_route() {
	local router

	while ip -4 route show default dev "$interface" 2>/dev/null | grep -q .; do
		ip -4 route del default dev "$interface" 2>/dev/null || break
	done
	for router in ${new_routers:-}; do
		if ! ip -4 route replace default via "$router" dev "$interface" 2>/dev/null; then
			ip -4 route replace default via "$router" dev "$interface" onlink
		fi
		break
	done
}

exit_with_hooks() {
	status=$1
	if [ -f /etc/dhclient-exit-hooks ]; then
		# shellcheck disable=SC1091
		. /etc/dhclient-exit-hooks
	fi
	exit "$status"
}

if [ -f /etc/dhclient-enter-hooks ]; then
	exit_status=0
	# shellcheck disable=SC1091
	. /etc/dhclient-enter-hooks
	if [ "$exit_status" -ne 0 ]; then
		exit "$exit_status"
	fi
fi

case "$reason" in
MEDIUM|ARPCHECK|ARPSEND)
	exit_with_hooks 0
	;;
PREINIT)
	ip link set dev "$interface" up
	sleep 1
	exit_with_hooks 0
	;;
BOUND|RENEW|REBIND|REBOOT)
	cidr=$(iface_cidr)
	ip -4 addr flush dev "$interface"
	if [ -n "${new_broadcast_address:-}" ]; then
		ip -4 addr add "${new_ip_address}/${cidr}" broadcast "$new_broadcast_address" dev "$interface"
	else
		ip -4 addr add "${new_ip_address}/${cidr}" dev "$interface"
	fi
	ensure_link_route "$cidr"
	set_default_route
	make_resolv_conf
	exit_with_hooks 0
	;;
EXPIRE|FAIL|RELEASE|STOP)
	ip -4 addr flush dev "$interface"
	while ip -4 route show default dev "$interface" 2>/dev/null | grep -q .; do
		ip -4 route del default dev "$interface" 2>/dev/null || break
	done
	rm -f /etc/resolv.conf.dhclient
	if [ -L /etc/resolv.conf ]; then
		rm -f /etc/resolv.conf
	fi
	: > /etc/resolv.conf
	exit_with_hooks 0
	;;
TIMEOUT)
	exit_with_hooks 1
	;;
*)
	exit_with_hooks 0
	;;
esac
