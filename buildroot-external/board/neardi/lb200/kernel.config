# Boot command line is passed from U-Boot (UART0 @ 0x2ad40000, ttyS0).
# CONFIG_CMDLINE is not set

# CONFIG_CPU_FREQ_DEFAULT_GOV_ONDEMAND is not set
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y

CONFIG_THERMAL_GOV_BANG_BANG=y
# CONFIG_SENSORS_GPIO_FAN is not set

CONFIG_KEYBOARD_GPIO=y
CONFIG_KEYBOARD_GPIO_POLLED=y

CONFIG_MMC_SDHCI_OF_DWCMSHC=y

# Rockchip RK3576 specific
CONFIG_PHY_ROCKCHIP_NANENG_COMBO_PHY=y
CONFIG_PHY_ROCKCHIP_PCIE3=y
CONFIG_PHY_ROCKCHIP_USB2P0=y
CONFIG_PHY_ROCKCHIP_SNPS_PCIE3=y
CONFIG_PHY_ROCKCHIP_Samsung_PCIE=y

# MMC/SD card
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_IO_ACCESSORS=y
CONFIG_MMC_SDHCI_ROCKCHIP=y
CONFIG_MMC_RKIC=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_EXYNOS=y
CONFIG_MMC_DW_ROCKCHIP=y

# USB
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_ROCKCHIP=y
CONFIG_USB_DWC2=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_ROCKCHIP=y
CONFIG_USB_CHIPIDEA=y
CONFIG_USB_CHIPIDEA_UDC=y
CONFIG_USB_CHIPIDEA_HOST=y
CONFIG_USB_GPIO_VBUS=y
CONFIG_USB_ROLE_SWITCH=y
CONFIG_USB_USB251XB=y

# USB Type-C PD
CONFIG_TYPEC=y
CONFIG_TYPEC_WESTBRIDGE=y
CONFIG_FUSB302=y

# Ethernet (CONFIG_ROCKCHIP_GMAC is obsolete; use DWMAC_ROCKCHIP)
CONFIG_NET_VENDOR_ROCKCHIP=y
CONFIG_STMMAC_ETH=y
CONFIG_STMMAC_PLATFORM=y
CONFIG_DWMAC_ROCKCHIP=y
CONFIG_MOTORCOMM_PHY=y

# CAN
CONFIG_CAN=y
CONFIG_CANFD_RK3576=y

# PWM / backlight
CONFIG_PWM_ROCKCHIP=y

# DisplayPort (USB-C Alt Mode)
CONFIG_DRM_DW_DP=y
CONFIG_ROCKCHIP_DW_DP=y

# RTC
CONFIG_RTC_DRV_HYM8563=y

# SPI
CONFIG_SPI_ROCKCHIP_SFC=y
CONFIG_SPI_SPIDEV=y

# I2C
CONFIG_I2C_CHARDEV=y

# GPIO
CONFIG_GPIO_ROCKCHIP=y

# Watchdog
CONFIG_DW_WATCHDOG=y

# WiFi SDIO support (Seekwave SV6160)
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_OF_ASPEED=n
CONFIG_SEEKWAVE_BSP_DRIVERS_V20=y
CONFIG_SKW_SDIOHAL=m
CONFIG_WLAN_VENDOR_SKW6316=m

# Sound
CONFIG_SND_SOC_ROCKCHIP=y
CONFIG_SND_SOC_ROCKCHIP_HDMI=y
CONFIG_SND_SOC_ROCKCHIP_I2S_TDM=y
CONFIG_SND_SOC_ROCKCHIP_SPDIF=y
CONFIG_SND_SOC_SIMPLE_AMPLIFIER=y
CONFIG_SND_SIMPLE_CARD=y

# Backlight
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_PWM=y

# Remote control (IR)
CONFIG_ROCKCHIP_REMOTECTL=y
CONFIG_ROCKCHIP_REMOTECTL_PWM=y

# ADC keys
CONFIG_KEYBOARD_ADC=y

# CPUfreq
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_STAT=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_USERSPACE=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_CONSERVATIVE=y
CONFIG_ARM_ROCKCHIP_CPUFREQ=y

# Power management
CONFIG_ROCKCHIP_PM_DOMAINS=y
CONFIG_ROCKCHIP_SUSPEND_MODE=y

# Rockchip SoC 支撑（保留）
CONFIG_CPU_RK3576=y
CONFIG_ROCKCHIP_OPP=y
CONFIG_ROCKCHIP_SYSTEM_MONITOR=y
CONFIG_ROCKCHIP_IPA=y
CONFIG_ROCKCHIP_PVTM=y
CONFIG_ROCKCHIP_IOMMU=y

# Rockchip multimedia (MPP / RGA / NPU)
CONFIG_ROCKCHIP_MPP_RKVDEC2=y
CONFIG_ROCKCHIP_MPP_RKVENC2=y
CONFIG_ROCKCHIP_MPP_IEP2=y
CONFIG_IEP=y
CONFIG_ROCKCHIP_MPP_SERVICE=y
CONFIG_ROCKCHIP_MPP_RKVDEC=y
CONFIG_ROCKCHIP_MPP_RKVENC=y
CONFIG_ROCKCHIP_MPP_JPGDEC=y
CONFIG_ROCKCHIP_MPP_JPGENC=y
CONFIG_ROCKCHIP_MULTI_RGA=y
CONFIG_ROCKCHIP_RKNPU=y
# CONFIG_VIDEO_ROCKCHIP_ISP is not set
# CONFIG_VIDEO_ROCKCHIP_RGA is not set

# Thermal (OTP must be built-in: tsadc trim cells are read at boot before rootfs)
CONFIG_ROCKCHIP_THERMAL=y
CONFIG_NVMEM_ROCKCHIP_OTP=y

# EDAC
CONFIG_EDAC_ROCKCHIP=y
