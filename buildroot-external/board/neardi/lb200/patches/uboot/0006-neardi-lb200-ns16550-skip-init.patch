From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: MCOS <support@muthur-command.com>
Subject: [PATCH] neardi/lb200: honor DEBUG_UART_SKIP_INIT in NS16550

CONFIG_DEBUG_UART_SKIP_INIT was ignored by the NS16550 debug-UART helpers.
_debug_uart_init() still waited on LSR TEMT and _debug_uart_putc() on THRE,
which hangs when vendor SPL/ATF already owns UART2.
---
--- a/drivers/serial/ns16550.c
+++ b/drivers/serial/ns16550.c
@@ -314,6 +314,9 @@ static inline void _debug_uart_init(void)
 	struct ns16550 *com_port = (struct ns16550 *)CONFIG_VAL(DEBUG_UART_BASE);
 	int baud_divisor;
 
+	if (IS_ENABLED(CONFIG_DEBUG_UART_SKIP_INIT))
+		return;
+
 	/* Wait until tx buffer is empty */
 	while (!(serial_din(&com_port->lsr) & UART_LSR_TEMT))
 		;
@@ -354,6 +357,11 @@ static inline void _debug_uart_putc(int ch)
 {
 	struct ns16550 *com_port = (struct ns16550 *)CONFIG_VAL(DEBUG_UART_BASE);
 
+	if (IS_ENABLED(CONFIG_DEBUG_UART_SKIP_INIT)) {
+		serial_dout(&com_port->thr, ch);
+		return;
+	}
+
 	while (!(serial_din(&com_port->lsr) & UART_LSR_THRE)) {
 #ifdef CONFIG_DEBUG_UART_NS16550_CHECK_ENABLED
 		if (!NS16550_read_baud_divisor(com_port))
