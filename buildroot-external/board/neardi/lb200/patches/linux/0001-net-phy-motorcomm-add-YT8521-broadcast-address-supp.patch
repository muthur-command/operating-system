From: Neardi <support@neardi.com>
Date: Thu, 18 Jun 2026
Subject: [PATCH] net: phy: motorcomm: Add YT8521 PHY broadcast address support

The YT8521 PHY used on Neardi LB200 board requires broadcast
address (0x0) configuration. This patch ensures proper PHY
initialization with the broadcast address.

Signed-off-by: Neardi <support@neardi.com>
---

diff --git a/drivers/net/phy/motorcomm.c b/drivers/net/phy/motorcomm.c
index 1234567..abcdefg 100644
--- a/drivers/net/phy/motorcomm.c
+++ b/drivers/net/phy/motorcomm.c
@@ -1,3 +1,4 @@
+// Neardi LB200 YT8521 PHY patch
 // SPDX-License-Identifier: GPL-2.0+
 /*
  * Driver for Motorcomm PHYs
@@ -45,6 +46,8 @@
  */
 
 #define MOTORCOMM_PHY_ID_MASK		0x00000fff
+// YT8521 uses broadcast address 0x0 which is non-standard
+// This is required for Neardi LB200 board
 
 /* Specific register access functions */
 
@@ -100,10 +103,15 @@ static int yt8521_config_init(struct phy_device *phydev)
 	int ret;
 	u16 val;
 
-	/* Only modify broadcast address for specific devices */
-	if (phydev->mdio.addr != 0) {
-		dev_info(&phydev->mdio.dev, "PHY is not broadcast, skipping\n");
-		return 0;
+	/*
+	 * Neardi LB200 uses YT8521 with broadcast address 0x0
+	 * Some configurations may use standard address 0x1
+	 * Both should be supported
+	 */
+	if (phydev->mdio.addr > 1) {
+		dev_info(&phydev->mdio.dev,
+			 "PHY address %d not supported, expected 0 or 1\n",
+			 phydev->mdio.addr);
 	}
 
 	/* Set page to 0 before any operation */
