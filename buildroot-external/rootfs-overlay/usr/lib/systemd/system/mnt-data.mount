[Unit]
Description=MCOS data partition
Wants=mcos-expand.service
DefaultDependencies=no
After=mcos-expand.service
Before=umount.target local-fs.target
Conflicts=umount.target
After=systemd-fsck@dev-disk-by\x2dlabel-mcos\x2ddata.service
Wants=systemd-fsck@dev-disk-by\x2dlabel-mcos\x2ddata.service systemd-growfs@mnt-data.service

[Mount]
What=/dev/disk/by-label/mcos-data
Where=/mnt/data
Type=ext4
Options=commit=30

[Install]
WantedBy=local-fs.target
