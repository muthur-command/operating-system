[Unit]
Description=MCOS supervisor
Requires=docker.service dbus.socket
Wants=rauc.service network-online.target mcos-apparmor.service time-sync.target systemd-journal-gatewayd.socket
After=docker.service dbus.socket mcos-apparmor.service time-sync.target systemd-journal-gatewayd.socket
RequiresMountsFor=/mnt/data /mnt/boot /mnt/overlay
StartLimitIntervalSec=30m
StartLimitBurst=3
ConditionPathExists=/run/dbus/system_bus_socket
ConditionPathExists=/run/docker.sock

[Service]
Type=simple
Restart=always
RestartSec=5s
ExecStartPre=-/usr/bin/docker stop mcos_supervisor
ExecStart=/usr/sbin/mcos-supervisor
ExecStop=-/usr/bin/docker stop mcos_supervisor
# A controlled stop leaves startup-marker in place; remove it so the next
# start does not treat a service restart as a crashed Supervisor.
ExecStopPost=-/bin/rm -f /run/supervisor/startup-marker

[Install]
WantedBy=multi-user.target
